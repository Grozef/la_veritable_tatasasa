# Adresse de l'API, prefixe /api compris. Injectee au BUILD : changer cette valeur impose
# de reconstruire l'application.
#
# En developpement navigateur, `php artisan serve` :
VITE_API_URL=http://localhost:8000/api
#
# Sur un telephone reel, `localhost` designe le TELEPHONE : il faut l'adresse de la
# machine sur le reseau local, et `php artisan serve --host=0.0.0.0`.
# VITE_API_URL=http://192.168.1.20:8000/api
